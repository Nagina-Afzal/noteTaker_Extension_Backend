# # Dockerfile.vercel — Vercel Docker deployment for the Meet Notetaker backend.
# # Vercel's Docker path builds this image and routes traffic to PORT 3000.

# FROM node:20-alpine AS base
# WORKDIR /app

# # Install dependencies with a clean, reproducible lockfile install.
# COPY package.json package-lock.json* ./
# RUN npm install --omit=dev --no-audit --no-fund

# # Copy application source.
# COPY src ./src
# COPY schema.sql ./schema.sql

# ENV NODE_ENV=production
# ENV PORT=3000

# EXPOSE 3000

# # Basic container health check against the readiness endpoint.
# HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
#   CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# CMD ["node", "src/server.js"]

{
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
